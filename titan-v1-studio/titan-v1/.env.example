# Server-side only (never NEXT_PUBLIC_) — used by app/api/*
RUNPOD_ENDPOINT_ID=your_endpoint_id
RUNPOD_API_KEY=your_runpod_api_key

# Same Supabase project as Titanposting (so it is the same user). Service role is server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Titanposting worker (media library upload) and web app (composer link)
NEXT_PUBLIC_TITANPOSTING_API_URL=http://localhost:8787
NEXT_PUBLIC_TITANPOSTING_APP_URL=http://localhost:5173
